{
  "name": "@diverlin/uikit",
  "version": "1.0.0",
  "description": "Diverlin UI Kit — framework-agnostic Web Components and pure CSS design system with light/dark themes, local fonts, and opt-in oklch accents.",
  "homepage": "https://d1verlin.github.io/diverlin-uikit/",
  "repository": {
    "type": "git",
    "url": "https://github.com/D1verlin/diverlin-uikit.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions.d.ts",
      "import": "./dist/actions.js"
    },
    "./inputs": {
      "types": "./dist/inputs.d.ts",
      "import": "./dist/inputs.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./navigation": {
      "types": "./dist/navigation.d.ts",
      "import": "./dist/navigation.js"
    },
    "./feedback": {
      "types": "./dist/feedback.d.ts",
      "import": "./dist/feedback.js"
    },
    "./data-display": {
      "types": "./dist/data-display.d.ts",
      "import": "./dist/data-display.js"
    },
    "./effects": {
      "types": "./dist/effects.d.ts",
      "import": "./dist/effects.js"
    },
    "./styles": "./dist/assets/styles.css"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build:uikit": "npm --prefix \"ui kit\" run build && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('ui kit/dist','dist',{recursive:true});\"",
    "build:docs": "npm --prefix \"guideline website\" run build",
    "build": "npm run build:uikit && npm run build:docs",
    "test": "npm --prefix \"ui kit\" test",
    "install:skills": "powershell -ExecutionPolicy Bypass -File ./install-skills.ps1"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "uikit",
    "design-system",
    "css-variables",
    "diverlin"
  ],
  "license": "MIT"
}
